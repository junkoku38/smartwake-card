{
  "compilerOptions": {
    "target": "es2021",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["es2021", "DOM", "DOM.Iterable"],
    "declaration": false,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*"]
}